# Frontend Environment Variables Template
# Copy this file to .env and update the values as needed

# API Base URL - Backend service endpoint
# For development: http://localhost:8080/api (default backend port)
# For production: https://your-api-domain.com/api
# The backend is running on port 8080 as mentioned in the issue
VITE_API_BASE_URL=http://localhost:8080/api

# Environment mode (automatically set by Vite, but can be overridden)
VITE_NODE_ENV=development

# Optional: Ngrok URL if using tunneling for development
# VITE_BACKEND_NGROK_URL=https://your-ngrok-url.ngrok-free.app